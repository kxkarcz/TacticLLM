# Raport + czat (Agno): anthropic (Claude, jedno wywołanie na mecz) albo ollama (lokalnie, za darmo)
TACTIC_REPORT_PROVIDER=anthropic
ANTHROPIC_API_KEY=
TACTIC_REPORT_MODEL=claude-sonnet-5-5
# tylko dla TACTIC_REPORT_PROVIDER=ollama
TACTIC_OLLAMA_REPORT_MODEL=qwen3:14b

# Adnotacje punktów: ollama (lokalnie, za darmo) albo gemini
# Ustawienia dobrane pod kartę 16 GB (np. RTX 4060 Ti 16GB).
# Modele 32B (np. qwen2.5vl:32b, ~21 GB) się nie mieszczą – byłyby wielokrotnie wolniejsze.
TACTIC_ANNOTATOR=ollama
TACTIC_OLLAMA_MODEL=qwen2.5vl:7b
# model ogląda cały punkt: 3 klatki na sekundę, maks. 64 klatki na punkt
TACTIC_OLLAMA_FPS=3
TACTIC_OLLAMA_MAX_FRAMES=64
# większe klatki = lepiej widać dalszą parę (896 mieści się w 16 GB; na 8 GB użyj 672)
TACTIC_OLLAMA_FRAME_WIDTH=896

# tylko dla TACTIC_ANNOTATOR=gemini
GOOGLE_API_KEY=
TACTIC_VIDEO_MODEL=gemini-3.6-flash

# Detekcja zawodników
# yolo11l lepiej wykrywa dalszą parę niż yolo11m, a na 16 GB działa bez problemu
TACTIC_YOLO_WEIGHTS=yolo11l.pt
TACTIC_DEVICE=0
TACTIC_ANALYSIS_FPS=10

# Język raportu
TACTIC_REPORT_LANGUAGE=polski
